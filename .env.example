TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# 逗号分隔的 Telegram 数字 user id。给 bot 发 /start 可看到自己的 id。
TELEGRAM_ALLOWED_IDS=123456789

CURSOR_API_KEY=cursor_...
# 主 key 失效（401/额度等）时自动切换
# CURSOR_API_KEY_BACKUP=crsr_...
CURSOR_MODEL=composer-2.5

# 可迁移知识库（playbook + 向量）。换机拷贝 data/knowledge.sqlite
# KNOWLEDGE_DB=./data/knowledge.sqlite
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_CACHE_DIR=./data/embedding-cache
# 若用 OpenAI 兼容向量 API：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# 可选。VPS_SECRET 首次启动会自动生成，用来加密 SSH 密码和库里的密钥。
# 换机器必须带上同一份，否则 data/bot.sqlite 里的密文解不开。
# VPS_SECRET=
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# VPS_INVENTORY=./data/vps.yaml
# SSH_TIMEOUT_MS=20000
# CMD_TIMEOUT_MS=30000
# CMD_MAX_OUTPUT=8000
# CONFIRM_TIMEOUT_MS=180000
# READ_FILE_MAX_BYTES=204800
# DEPLOY_TIMEOUT_MS=180000

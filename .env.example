TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# 逗号分隔的 Telegram 数字 user id。给 bot 发 /start 可看到自己的 id。
TELEGRAM_ALLOWED_IDS=123456789

CURSOR_API_KEY=cursor_...
CURSOR_MODEL=composer-2.5

# 可选。VPS_SECRET 首次启动会自动生成，用来加密 SSH 密码和库里的密钥。
# 换机器必须带上同一份，否则 data/bot.sqlite 里的密文解不开。
# VPS_SECRET=
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# VPS_INVENTORY=./data/vps.yaml
# SSH_TIMEOUT_MS=20000
# CMD_TIMEOUT_MS=30000
# CMD_MAX_OUTPUT=8000
# CONFIRM_TIMEOUT_MS=60000
# READ_FILE_MAX_BYTES=204800
# DEPLOY_TIMEOUT_MS=180000
